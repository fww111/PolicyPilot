{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["decision_id", "status", "premises", "evidence"],
  "properties": {
    "decision_id": {"type": "string"},
    "status": {"enum": ["supported", "refuted", "unknown", "conflict"]},
    "premises": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["anchor_ids", "supports"],
        "properties": {
          "anchor_ids": {"type": "array", "items": {"type": "string"}},
          "supports": {"type": "boolean"},
          "note": {"type": "string"}
        }
      }
    },
    "missing_items": {"type": "array", "items": {"type": "string"}},
    "version_set": {"type": "object"}
  }
}
