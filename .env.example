# ===== 大模型 API（OpenAI 兼容接口均可）=====
# 示例：智谱 https://open.bigmodel.cn/api/paas/v4  |  DeepSeek https://api.deepseek.com
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 抽取专用便宜模型（批量处理政策文件时用，省钱）
LLM_EXTRACT_MODEL=deepseek-chat

# ===== Neo4j 图数据库（docker run -d -p 7474:7474 -p 7687:7687 -e NEO4J_AUTH=neo4j/policy123 neo4j:5）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=policy123

# ===== MinerU 多模态解析（可选，复杂版面PDF用；不配则回退 pdfplumber）=====
# MinerU_API_KEY=

# ===== 爬虫礼貌配置 =====
CRAWLER_DELAY_SECONDS=3
CRAWLER_USER_AGENT=PolicyPilot-Research/0.1 (student competition; contact: your-email@example.com)

# 强制思考模型的思考档位(low/high/max)；非思考模型(如DeepSeek-chat)设为空
LLM_THINKING_LEVEL=low
